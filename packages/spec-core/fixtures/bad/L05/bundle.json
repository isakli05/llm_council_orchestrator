    {
      "term": "Todo List",
      "definition": "An ordered set of todo entries owned by one account."
    },
    {
      "term": "Deadline",
      "definition": "The timestamp after which a todo entry is overdue."
    },
    {
      "term": "Notification",
      "definition": "An outbound message telling an owner a deadline is near."
    }
  ],
